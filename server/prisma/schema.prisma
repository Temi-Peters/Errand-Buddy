generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RUNNER
  ADMIN
}

enum RunnerStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  CHARGE
  OVERAGE
  REIMBURSEMENT
}

enum BookingType {
  ONE_OFF_TASK
  WEEKLY_SUBSCRIPTION
}

enum CarerLinkStatus {
  PENDING
  ACTIVE
}

// What the runner should do when an item isn't on the shelf. Defaults to
// ASK_ME_FIRST because guessing on someone else's shopping is the single biggest
// source of disputes in a human-shopped grocery errand.
// What a runner did with each item on the list. Recorded per item so "they
// didn't have it" stops being a free-text conversation and becomes evidence.
enum ItemStatus {
  PENDING
  BOUGHT
  SUBSTITUTED
  UNAVAILABLE
}

// REQUEST photos are the customer showing which product they mean; RECEIPT is the
// runner's proof of what was actually spent.
enum PhotoKind {
  REQUEST
  RECEIPT
}

enum SubstitutionPreference {
  ASK_ME_FIRST
  SUBSTITUTE_FREELY
  NO_SUBSTITUTES
}

enum ServiceType {
  DOG_WALKING
  GROCERY_SHOPPING
  PRESCRIPTION_PICKUP
  DRY_CLEANING
  GENERAL_ERRANDS
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            UserRole
  // Set whenever the password changes. Tokens issued before this moment are
  // rejected at auth time, so a reset actually logs out anyone already holding a
  // token for the account rather than leaving them signed in until it expires.
  passwordChangedAt DateTime?
  customerProfile CustomerProfile?
  runnerProfile   RunnerProfile?
  sentMessages    Message[]        @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Only the SHA-256 hash of the reset token is stored, so a leak of this table
// can't be used to reset anyone's password. Tokens are single-use and short-lived.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model CustomerProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  address            String
  phone              String
  postcodeArea       String
  avatarUrl          String?
  walletBalance      Decimal              @default(0) @db.Decimal(10, 2)
  bookings           Booking[]
  reviews            Review[]
  walletTransactions WalletTransaction[]
  bookingTemplates   BookingTemplate[]
  carerLinksAsCarer  CarerLink[]          @relation("CarerLinksAsCarer")
  carerLinksAsClient CarerLink[]          @relation("CarerLinksAsClient")
  carerBookings      Booking[]            @relation("CarerBookings")
  claims             Claim[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model CarerLink {
  id        String          @id @default(cuid())
  carerId   String
  carer     CustomerProfile @relation("CarerLinksAsCarer", fields: [carerId], references: [id], onDelete: Cascade)
  clientId  String
  client    CustomerProfile @relation("CarerLinksAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  status    CarerLinkStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([carerId, clientId])
  @@index([carerId])
  @@index([clientId])
}

model RunnerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String       @default("")
  area            String
  bio             String       @default("")
  transportMethod String       @default("")
  availabilityNotes String    @default("")
  rating          Decimal      @default(0) @db.Decimal(2, 1)
  completedTasks  Int          @default(0)
  status          RunnerStatus @default(PENDING)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  suspendedAt     DateTime?
  stripeAccountId String?
  idVerifiedAt    DateTime?
  avatarUrl       String?
  bookings        Booking[]
  reviews         Review[]
  documents       RunnerDocument[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// Verification documents held transiently for admin review only. Deleted the
// moment a runner is approved or rejected (data minimisation) — only the
// idVerifiedAt audit stamp on RunnerProfile is retained afterwards.
model RunnerDocument {
  id        String        @id @default(cuid())
  runnerId  String
  runner    RunnerProfile @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  type      String
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime      @default(now())

  @@index([runnerId])
}

model Booking {
  id               String           @id @default(cuid())
  customerId       String
  customer         CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  runnerId         String?
  runner           RunnerProfile?   @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  createdByCarerId String?
  createdByCarer   CustomerProfile? @relation("CarerBookings", fields: [createdByCarerId], references: [id], onDelete: SetNull)
  serviceType      ServiceType
  bookingType      BookingType
  subscriptionPlan String?
  date             DateTime
  time             String
  // What the customer was actually charged. discountAmount records how much was
  // taken off the standard tariff, so the list price is price + discountAmount
  // and revenue reporting can tell a promotion apart from a cheaper booking.
  price            Decimal          @db.Decimal(10, 2)
  discountAmount   Decimal?         @db.Decimal(10, 2)
  status           BookingStatus    @default(PENDING)
  instructions     String
  address          String
  contactPhone     String
  postcodeArea     String
  review               Review?
  payment              Payment?
  items                BookingItem[]
  photos               BookingPhoto[]
  messages             Message[]
  claims               Claim[]
  // Lifecycle stamps. updatedAt only ever shows the LAST change, so without these
  // there is no way to ask how long a booking waited for a runner or how long the
  // errand took — the two numbers that say whether the model actually works.
  // Only populated from the point these were added; older rows stay null.
  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  overageCoveredAmount Decimal?         @db.Decimal(10, 2)
  overageCoveredAt     DateTime?
  onHoldUntil          DateTime?
  // What the customer agreed to spend on the shopping itself, set when booking.
  // The runner cannot charge past it without recording a reason, and anything
  // above it is held as an overage for the customer to approve rather than
  // silently taken — "you never pay more than you agreed".
  goodsBudget            Decimal?               @db.Decimal(10, 2)
  substitutionPreference SubstitutionPreference @default(ASK_ME_FIRST)
  overageReason          String?
  goodsCost            Decimal?         @db.Decimal(10, 2)
  goodsChargedAt       DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([customerId])
  @@index([runnerId])
  @@index([status])
  @@index([createdByCarerId])
  @@index([createdAt])
}

// One line of the shopping list. Optional — a booking can still be a single
// free-text instruction — but structured items are what let a runner mark
// something unavailable and let a customer name a backup in advance.
model BookingItem {
  id             String     @id @default(cuid())
  bookingId      String
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  position       Int        @default(0)
  name           String
  quantity       String     @default("")
  // "if no Hovis, get Warburtons" — the cheapest substitution intelligence there
  // is, and it removes a phone call while the runner stands in the aisle.
  backupName     String?
  status         ItemStatus @default(PENDING)
  substitutedWith String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([bookingId])
}

// Stored as a client-downscaled data URL, following the avatar pattern rather
// than the RunnerDocument Bytes pattern: these are small, need no separate
// binary route, and must survive for the life of the booking. Kept in their own
// table so the bookings list — polled every 45s — never carries image payloads.
model BookingPhoto {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind         PhotoKind
  dataUrl      String
  caption      String?
  uploadedById String?
  createdAt    DateTime  @default(now())

  @@index([bookingId])
  @@index([bookingId, kind])
}

model Review {
  id         String          @id @default(cuid())
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  runnerId   String
  runner     RunnerProfile   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  stars      Int
  review     String
  createdAt  DateTime        @default(now())

  @@index([customerId])
  @@index([runnerId])
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("gbp")
  status                PaymentStatus @default(REQUIRES_CONFIRMATION)
  stripePaymentIntentId String?
  stripeTransferId      String?
  platformFeeAmount     Decimal       @db.Decimal(10, 2)
  runnerPayoutAmount    Decimal       @db.Decimal(10, 2)
  goodsReimbursementAmount Decimal?   @db.Decimal(10, 2)
  goodsTransferId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([senderId])
  @@index([receiverId])
}

model BookingTemplate {
  id           String          @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  serviceType  ServiceType
  bookingType  BookingType
  subscription String?
  time         String
  instructions String
  address      String
  contactPhone String
  postcodeArea String
  price        Decimal         @db.Decimal(10, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([customerId])
}

model WalletTransaction {
  id                    String                @id @default(cuid())
  customerId            String
  customer              CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                  WalletTransactionType
  amount                Decimal               @db.Decimal(10, 2)
  description           String                @default("")
  stripePaymentIntentId String?
  bookingId             String?
  createdAt             DateTime              @default(now())

  @@index([customerId])
}

model SurveyResponse {
  id              String   @id @default(cuid())
  wouldUse        String
  valueRating     Int
  pricePreference String
  standoutFeature String
  comment         String?
  email           String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

enum ClaimStatus {
  OPEN
  RESOLVED
  REJECTED
}

model Claim {
  id             String          @id @default(cuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category       String
  description    String
  status         ClaimStatus     @default(OPEN)
  resolutionNote String?
  refundAmount   Decimal?        @db.Decimal(10, 2)
  stripeRefundId String?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  @@index([customerId])
  @@index([bookingId])
  @@index([status])
}
